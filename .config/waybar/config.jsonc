  },
  {
    "height": 40,
    "layer": "top",
    "output": "!HDMI-A-1",
    "include": ["~/.config/waybar/modules.jsonc"],
    "modules-left": ["custom/arch"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["pulseaudio", "clock", "custom/power-menu"],
  },
]
